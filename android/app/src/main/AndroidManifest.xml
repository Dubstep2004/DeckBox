<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- «Компьютер спит»: the screen comes back on when the computer wakes up -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- "Обновить" on the update card: the app installs its own new version (Android asks once to confirm) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Dictation widget only: asked for the first time its microphone button is tapped -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11+: the speech recognizer has to be visible to the app (Dictation widget) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="DeckBox"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeskPanel">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing without USB: the QR code on the computer's settings page. Android 12+ opens unverified https
                 links in the browser; that page then offers deckbox://pair (the second filter). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dubstep2004.github.io" android:pathPrefix="/DeckBox/pair" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="deckbox" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Settings › Display › "Use as the phone's home screen": enabled by the app itself (off by default). As the home
             app the panel starts after a reboot and the Home button returns to it; no root needed. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver android:name=".AppUpdater$InstallResult" android:exported="false" />
        <!-- after "Обновить" the new version opens the panel again by itself -->
        <receiver android:name=".AppUpdater$Replaced" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>

        <!-- Quick Settings tile (Edit tiles › DeckBox): opens the panel. Android 7.0+ only shows tiles. -->
        <service
            android:name=".PanelTile"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="DeckBox"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>
    </application>
</manifest>
